                    <TextBox Text="{Binding Dev.Mod_AI_Power.Channels[2].FitRatio}" Grid.Row ="3" Grid.Column="8" ToolTip ="滤波系数，1-50"/>
                    <TextBox Text="{Binding Dev.Mod_AI_Power.Channels[3].FitRatio}" Grid.Row ="4" Grid.Column="8" ToolTip ="滤波系数，1-50"/>
                    <TextBox Text="{Binding Dev.Mod_AI_Power.Channels[4].FitRatio}" Grid.Row ="5" Grid.Column="8" ToolTip ="滤波系数，1-50"/>
