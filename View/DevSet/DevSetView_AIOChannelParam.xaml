                    <ComboBox ItemsSource="{Binding Dev.FilterTypeList}" SelectedIndex ="{Binding Dev .Mod_AI_Power.Channels[3].FilterType, Mode=TwoWay}" Grid.Row ="4" Grid.Column="7" ToolTip ="0中值,1平均,2抗干扰中值,3惯性"/>
                    <ComboBox ItemsSource="{Binding Dev.FilterTypeList}" SelectedIndex ="{Binding Dev .Mod_AI_Power.Channels[4].FilterType, Mode=TwoWay}" Grid.Row ="5" Grid.Column="7" ToolTip ="0中值,1平均,2抗干扰中值,3惯性"/>
                    <ComboBox ItemsSource="{Binding Dev.FilterTypeList}" SelectedIndex ="{Binding Dev .Mod_AI_Power.Channels[5].FilterType, Mode=TwoWay}" Grid.Row ="6" Grid.Column="7" ToolTip ="0中值,1平均,2抗干扰中值,3惯性"/>
                    <ComboBox ItemsSource="{Binding Dev.FilterTypeList}" SelectedIndex ="{Binding Dev .Mod_AI_Power.Channels[6].FilterType, Mode=TwoWay}" Grid.Row ="7" Grid.Column="7" ToolTip ="0中值,1平均,2抗干扰中值,3惯性"/>

                    <TextBlock Text="滤波强度" Grid.Row ="0" Grid.Column="8" Style="{StaticResource TextBlock1}"/>
                    <TextBox Text="{Binding Dev.Mod_AI_Power.Channels[0].FitRatio}" Grid.Row ="1" Grid.Column="8" ToolTip ="滤波系数，1-50"/>
