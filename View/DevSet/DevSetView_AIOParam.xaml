                            <TextBlock Text="信号名称" Grid.Row ="0" Grid.Column="1" Style="{StaticResource TextBlock1}"/>
                            <TextBox Text="{Binding Dev.AIList[10].SingalName,Mode =TwoWay}" Grid.Row ="1" Grid.Column="1" IsEnabled ="False" />

                            <TextBlock Text="单位" Grid.Row ="0" Grid.Column="2" Style="{StaticResource TextBlock1}"/>
                            <TextBox Text="{Binding Dev.AIList[10].SingalUnit,Mode =TwoWay}" Grid.Row ="1" Grid.Column="2" IsEnabled ="False" />

                            <TextBlock Text="量程下限" Grid.Row ="0" Grid.Column="3" Style="{StaticResource TextBlock1}"/>
                            <TextBox Text="{Binding Dev.AIList[10].SingalLowerRange,Mode =TwoWay}" Grid.Row ="1" Grid.Column="3" Width="140"/>

                            <TextBlock Text="量程上限" Grid.Row ="0" Grid.Column="4" Style="{StaticResource TextBlock1}"/>
                            <TextBox Text="{Binding Dev.AIList[10].SingalUpperRange,Mode =TwoWay}" Grid.Row ="1" Grid.Column="4" Width="140"/>

                            <TextBlock Text="接口类型" Grid.Row ="0" Grid.Column="5" Style="{StaticResource TextBlock1}"/>
                            <ComboBox ItemsSource="{Binding Dev.InfTypeList}" SelectedItem ="{Binding Dev.AIList[10].InfType,Mode =TwoWay}" Grid.Row="1" Grid.Column ="5" IsEnabled =" False" />

                            <TextBlock Text="电信号单位" Grid.Row ="2" Grid.Column="0" Style="{StaticResource TextBlock1}"/>
                            <TextBox Text="{Binding Dev.AIList[10].ElecSig_Unit,Mode =TwoWay}" Grid.Row ="3" Grid.Column="0" IsEnabled ="False"/>

                            <TextBlock Text="电信号下限" Grid.Row ="2" Grid.Column="1" Style="{StaticResource TextBlock1}"/>
                            <TextBox Text="{Binding Dev.AIList[10].ElecSigLowerRange,Mode =TwoWay}" Grid.Row ="3" Grid.Column="1" Width="140" IsEnabled =" False" />

                            <TextBlock Text="电信号上限" Grid.Row ="2" Grid.Column="2" Style="{StaticResource TextBlock1}"/>
                            <TextBox Text="{Binding Dev.AIList[10].ElecSigUpperRange,Mode =TwoWay}" Grid.Row ="3" Grid.Column="2" Width="140" IsEnabled =" False" />

                            <TextBlock Text="接入模块" Grid.Row ="2" Grid.Column="3" Style="{StaticResource TextBlock1}"/>
                            <TextBox Text="{Binding Dev.AIList[10].ModulNO,Mode =TwoWay}" Grid.Row ="3" Grid.Column="3" IsEnabled =" False" />

                            <TextBlock Text="通道序号" Grid.Row ="2" Grid.Column="4" Style="{StaticResource TextBlock1}"/>
                            <TextBox Text="{Binding Dev.AIList[10].ChannelSerialNO,Mode =TwoWay}"  Grid.Row ="3" Grid.Column="4" ToolTip ="该信号在模块中的序号，从1开始" IsEnabled ="False" />

                            <TextBlock Text="转换比率" Grid.Row ="2" Grid.Column="5" Style="{StaticResource TextBlock1}"/>
                            <TextBox Text="{Binding Dev.AIList[10].ConvRatio,Mode =TwoWay}" Grid.Row ="3" Grid.Column="5" ToolTip ="信号实际值=传输数据*比率"  Width="140"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>


        </TabControl>
        <Button Content="保存设置" Command="{Binding MainWinCommand}" CommandParameter="8299" Grid.Row="1" Grid.Column ="1" HorizontalAlignment="Left" VerticalAlignment="Center" IsDefault="True"/>
        <Button Content="取消修改" Command="{Binding MainWinCommand}" CommandParameter="8199"  Grid.Row="1" Grid.Column ="1"  HorizontalAlignment="Right" VerticalAlignment="Center" IsCancel="True"/>
        <TextBlock Text="修改后请先保存再关闭窗口！" Margin ="10"  Grid.Row="1" Grid.Column ="0" Style="{StaticResource TextBlock2}" FontSize="20" FontWeight="Bold" Foreground="OrangeRed"/>
    </Grid>
</mah:MetroWindow>
