<mah:MetroWindow x:Class="BRX.View.DevSet.DevSetView_BisicInfo"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:BRX.View.DevSet"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
                 mc:Ignorable="d"
                 Title="装置基本信息设置" Height="600" Width="1024"
                 MinWidth="600" MinHeight="500"
                 WindowStartupLocation="CenterScreen" Background="White" ShowInTaskbar="True"
                 Closing="Window_Closing" WindowState="Normal " ResizeMode ="CanMinimize"
                 DataContext ="{Binding Source ={StaticResource Locator },Path =MainVM}">

    <Grid Background ="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column ="0" Grid.ColumnSpan ="2" BorderBrush="Black" BorderThickness="1" CornerRadius="5"  HorizontalAlignment="stretch" VerticalAlignment="stretch" Margin="10">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="装置名称：" Grid.Row="0" Grid.Column ="0" Style="{StaticResource TextBlock1}"/>
                <TextBlock Text="装置型号：" Grid.Row="1" Grid.Column ="0" Style="{StaticResource TextBlock1}"/>
                <TextBlock Text="出厂编号：" Grid.Row="2" Grid.Column ="0" Style="{StaticResource TextBlock1}"/>
                <TextBlock Text="参考标准：" Grid.Row="3" Grid.Column ="0" Style="{StaticResource TextBlock1}"/>
                <TextBox Text="{Binding Dev.DeviceName, Mode=TwoWay}"  Grid.Row="0" Grid.Column ="1" Width="800" />
                <TextBox Text="{Binding Dev.DeviceType, Mode=TwoWay}"  Grid.Row="1" Grid.Column ="1" Width="800" />
                <TextBox Text="{Binding Dev.DeviceSerialNO, Mode=TwoWay}"  Grid.Row="2" Grid.Column ="1" Width="800" />
                <TextBox Text="{Binding Dev.ReferenceStd, Mode=TwoWay}"  Grid.Row="3" Grid.Column ="1" Width="800" Height ="80" />
            </Grid>
        </Border>
        <Button Content="保存设置" Command="{Binding MainWinCommand}" CommandParameter="8299" Grid.Row="1" Grid.Column ="1" HorizontalAlignment="Left" VerticalAlignment="Center" IsDefault="True"/>
        <Button Content="取消修改" Command="{Binding MainWinCommand}" CommandParameter="8199"  Grid.Row="1" Grid.Column ="1" HorizontalAlignment="Right" VerticalAlignment="Center" IsCancel="True"/>
        <TextBlock Text="修改后请先保存再关闭窗口！" Margin ="10"  Grid.Row="1" Grid.Column ="0" Style="{StaticResource TextBlock2}" FontSize="20" FontWeight="Bold" Foreground="OrangeRed"/>
    </Grid>
</mah:MetroWindow>
