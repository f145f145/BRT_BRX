<mah:MetroWindow  x:Class="BRX.View.MainView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d3="http://research.microsoft.com/DynamicDataDisplay/1.0"
                  xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                  GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
                                    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
                  mc:Ignorable="d"
                  Title="建筑材料不燃性测试 GB/T-5464  ISO-1182"
                  Width="1366" Height="768"
                  WindowStartupLocation="CenterScreen"
                  ShowInTaskbar="True"
                  Closing="Window_Closing" ResizeMode="CanMinimize" 
                  WindowState ="Normal"
                  DataContext ="{Binding Source ={StaticResource Locator },Path =MainVM}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <!--=====主页面===================================================================================================-->
        <TabControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="9" Margin="5">
            <!--===========检测试验===========-->
            <TabItem Header="【检测试验】" IsEnabled="True" mah:HeaderedControlHelper.HeaderFontSize="16" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="150" MinHeight="60" MaxHeight="500"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth ="300" MaxWidth="1200"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="建筑材料不燃性测试—检测试验" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Style="{StaticResource TextBlock1}" FontSize="24" FontWeight="Bold"/>
                    <Button Content="退出系统" Click ="Button_Quit_Click" Grid.Row="0" Grid.Column ="3" Width="150" Height="40" HorizontalAlignment="Right" Margin="0,0,10,0" ToolTip ="退出软件，退出前请停止实验，关闭所有子窗口"/>

                    <!--左上半屏，参数、状态-->
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="Black" BorderThickness="1" CornerRadius="5" Margin="5" Padding="5"  Background="LightSkyBlue">
                        <Grid >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="炉内温度1：" Grid.Row="0" Grid.Column ="0" Style="{StaticResource TextBlock2}" Margin="0"/>
                            <TextBlock Text="炉内温度2：" Grid.Row="0" Grid.Column ="2" Style="{StaticResource TextBlock2}" Margin="0" Visibility="{Binding Dev.IsStd2023, Converter={StaticResource BVConverter}}"/>
                            <TextBox Text="{Binding Dev.AIList[0].ValueFinal, StringFormat={}{0:0.00} ℃}" Grid.Row="0" Grid.Column="1" Style="{StaticResource TextBox2}" IsReadOnly="True"/>
                            <TextBox Text="{Binding Dev.AIList[1].ValueFinal, StringFormat={}{0:0.00} ℃}" Grid.Row="0" Grid.Column="3" Style="{StaticResource TextBox2}" IsReadOnly="True" Visibility="{Binding Dev.IsStd2023, Converter={StaticResource BVConverter}}"/>

                            <TextBlock Text="试样中心：" Grid.Row="1" Grid.Column ="0" Visibility="{Binding ExpBRXDQ.UseAddT, Converter={StaticResource BVConverter}}" Style="{StaticResource TextBlock2}" Margin="0"/>
                            <TextBlock Text="试样表面：" Grid.Row="1" Grid.Column ="2" Visibility="{Binding ExpBRXDQ.UseAddT, Converter={StaticResource BVConverter}}" Style="{StaticResource TextBlock2}" Margin="0"/>
                            <TextBox Text="{Binding Dev.AIList[2].ValueFinal, StringFormat={}{0:0.00} ℃}" Visibility="{Binding ExpBRXDQ.UseAddT, Converter={StaticResource BVConverter}}" Grid.Row="1" Grid.Column="1" Style="{StaticResource TextBox2}"  IsReadOnly="True"/>
                            <TextBox Text="{Binding Dev.AIList[3].ValueFinal, StringFormat={}{0:0.00} ℃}" Visibility="{Binding ExpBRXDQ.UseAddT, Converter={StaticResource BVConverter}}" Grid.Row="1" Grid.Column="3" Style="{StaticResource TextBox2}" IsReadOnly="True"/>

                            <TextBlock Text="检测电压：" Grid.Row="2" Grid.Column ="0" Visibility="{Binding Dev.WithPowerSenser, Converter={StaticResource BVConverter}}" Style="{StaticResource TextBlock2}" Margin="0"/>
                            <TextBlock Text="输出功率：" Grid.Row="2" Grid.Column ="2" Visibility="{Binding Dev.WithPowerSenser, Converter={StaticResource BVConverter}}" Style="{StaticResource TextBlock2}" Margin="0"/>
                            <TextBox Text="{Binding Dev.AIList[8].ValueFinal, StringFormat={}{0:0.00} V}" Visibility="{Binding Dev.WithPowerSenser, Converter={StaticResource BVConverter}}" Grid.Row="2" Grid.Column="1" Style="{StaticResource TextBox2}"  IsReadOnly="True"/>
                            <TextBox Text="{Binding Dev.AIList[10].ValueFinal, StringFormat={}{0:0.00} W}" Visibility="{Binding Dev.WithPowerSenser, Converter={StaticResource BVConverter}}" Grid.Row="2" Grid.Column="3" Style="{StaticResource TextBox2}" IsReadOnly="True"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="Black" BorderThickness="1" CornerRadius="5"  Margin="5" Padding="0" Background="LightSkyBlue">
                        <Grid >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="当前实验：" Grid.Row="0" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                            <TextBox Text="{Binding ExpBRXDQ.IsCompleted, Converter={StaticResource BTConverter},Mode=OneWay}" Grid.Row="0" Grid.Column ="1" 
                                     ToolTip="当前试验完成情况" Style="{StaticResource TextBox4}" FontWeight="Bold" FontSize="20" IsReadOnly="True" Visibility="{Binding Dev.HideSY2345, Converter={StaticResource BVNotConverter}}"/>
                            <TextBox Text="{Binding ExpBRXDQ.ExpNO, Mode=OneWay}" Grid.Row="1" Grid.Column ="0" Grid.ColumnSpan="4"  Style="{StaticResource TextBox4}" IsReadOnly="True"/>
                            <TextBlock Text="完成数量：" Grid.Row="2" Grid.Column ="0" Style="{StaticResource TextBlock2}" Visibility="{Binding Dev.HideSY2345, Converter={StaticResource BVNotConverter}}"/>
                            <TextBox Text="{Binding ExpBRXDQ.QtyComplete,Mode=OneWay}" Grid.Row="2" Grid.Column ="1" Style="{StaticResource TextBox4}" IsReadOnly="True" Visibility="{Binding Dev.HideSY2345, Converter={StaticResource BVNotConverter}}"/>
                            <TextBlock Text="/" Grid.Row="2" Grid.Column ="2" HorizontalAlignment="Center" Style="{StaticResource TextBlock2}" Visibility="{Binding Dev.HideSY2345, Converter={StaticResource BVNotConverter}}"/>
                            <TextBox Text="{Binding ExpBRXDQ.YPSL,Mode=OneWay}" Grid.Row="2" Grid.Column ="3" Style="{StaticResource TextBox4}" IsReadOnly="True" Visibility="{Binding Dev.HideSY2345, Converter={StaticResource BVNotConverter}}"/>
                        </Grid>
                    </Border>

                    <!--横向分割线-->
                    <GridSplitter Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Height="3" VerticalAlignment="Center" HorizontalAlignment="stretch"/>
                    <!--左下屏-->
                    <TabControl Grid.Row="3" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Margin="5">
                        <TabItem Header="[炉内温度]" IsEnabled="True" mah:HeaderedControlHelper.HeaderFontSize="16" >
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="3"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" Margin="5" BorderBrush="Black" BorderThickness="1" CornerRadius="5">
                                    <d3:ChartPlotter x:Name="ChartPlotter11" >
                                        <d3:VerticalAxisTitle x:Name="AxisY_Default_Title11" Content="炉内温度T1" />
                                        <d3:AxisGrid Visibility ="Visible "></d3:AxisGrid>
                                        <d3:LineGraph Name="Line11" StrokeThickness="0.6" DataSource="{Binding PlotLines[0].LineDataSource}" Stroke ="Red"></d3:LineGraph>
                                        <d3:LineGraph Name="Line755" StrokeThickness="0.6"  DataSource="{Binding LineMaxMin[0].LineDataSource}" Stroke ="Blue"></d3:LineGraph>
                                        <d3:LineGraph Name="Line745" StrokeThickness="0.6"  DataSource="{Binding LineMaxMin[1].LineDataSource}" Stroke ="Blue"></d3:LineGraph>
                                        <d3:CursorCoordinateGraph  Name="Cross11" AutoHide="True" />
                                    </d3:ChartPlotter>
                                </Border>
                                <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="3" VerticalAlignment="Center" HorizontalAlignment="stretch"/>
                                <Border Grid.Row="2" Grid.Column="0" Margin="5" BorderBrush="Black" BorderThickness="1" CornerRadius="5" Visibility="{Binding Dev.IsStd2023, Converter={StaticResource BVConverter}}">
                                    <d3:ChartPlotter x:Name="ChartPlotter12" >
                                        <d3:VerticalAxisTitle x:Name="AxisY_Default_Title12" Content="炉内温度T2" />
                                        <d3:AxisGrid Visibility ="Visible "></d3:AxisGrid>
                                        <d3:LineGraph Name="Line12" StrokeThickness="0.6" DataSource="{Binding PlotLines[1].LineDataSource}" Stroke ="Red"></d3:LineGraph>
                                        <d3:LineGraph Name="Line7552" StrokeThickness="0.6"  DataSource="{Binding LineMaxMin[0].LineDataSource}" Stroke ="Blue"></d3:LineGraph>
                                        <d3:LineGraph Name="Line7452" StrokeThickness="0.6"  DataSource="{Binding LineMaxMin[1].LineDataSource}" Stroke ="Blue"></d3:LineGraph>
                                        <d3:CursorCoordinateGraph  Name="Cross12" AutoHide="True" />
                                    </d3:ChartPlotter>
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem Header="[试样温度及输出]" IsEnabled="True" mah:HeaderedControlHelper.HeaderFontSize="16" >
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="3"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" Margin="5" BorderBrush="Black" BorderThickness="1" CornerRadius="5">
                                    <d3:ChartPlotter x:Name="ChartPlotter21" >
                                        <d3:VerticalAxisTitle x:Name="AxisY_Default_Title21" Content="试样温度" />
                                        <d3:AxisGrid Visibility ="Visible "></d3:AxisGrid>
                                        <d3:LineGraph Name="Line21" StrokeThickness="0.6" DataSource="{Binding PlotLines[2].LineDataSource}" Stroke ="Red"></d3:LineGraph>
                                        <d3:LineGraph Name="Line22" StrokeThickness="0.6" DataSource="{Binding PlotLines[3].LineDataSource}" Stroke ="Blue"></d3:LineGraph>
                                        <d3:CursorCoordinateGraph  Name="Cross21" AutoHide="True" />
                                    </d3:ChartPlotter>
                                </Border>
                                <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="3" VerticalAlignment="Center" HorizontalAlignment="stretch"/>
                                <Border Grid.Row="2" Grid.Column="0" Margin="5" BorderBrush="Black" BorderThickness="1" CornerRadius="5" Visibility="{Binding ExpBRXDQ.UseAddT, Converter={StaticResource BVConverter}}">
                                    <d3:ChartPlotter x:Name="ChartPlotter22" >
                                        <d3:VerticalAxisTitle x:Name="AxisY_Default_Title22" Content="电压/功率" />
                                        <d3:AxisGrid Visibility ="Visible "></d3:AxisGrid>
                                        <d3:LineGraph Name="Line24" StrokeThickness="0.6" DataSource="{Binding PlotLines[9].LineDataSource}" Stroke ="Red"></d3:LineGraph>
                                        <d3:CursorCoordinateGraph  Name="Cross22" AutoHide="True" />
                                    </d3:ChartPlotter>
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem Header="[电压、电流、功率]" IsEnabled="True" mah:HeaderedControlHelper.HeaderFontSize="16"  Visibility="{Binding Dev.WithPowerSenser, Converter={StaticResource BVConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="3"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" Margin="5" BorderBrush="Black" BorderThickness="1" CornerRadius="5">
                                    <d3:ChartPlotter x:Name="ChartPlotter61" >
                                        <d3:VerticalAxisTitle x:Name="AxisY_Default_Title61" Content="电压、电流" />
                                        <d3:AxisGrid Visibility ="Visible "></d3:AxisGrid>
                                        <d3:LineGraph Name="Line61" StrokeThickness="0.6" DataSource="{Binding PlotLines[16].LineDataSource}" Stroke ="Red"></d3:LineGraph>
                                        <d3:LineGraph Name="Line62" StrokeThickness="0.6" DataSource="{Binding PlotLines[17].LineDataSource}" Stroke ="Blue"></d3:LineGraph>
                                        <d3:CursorCoordinateGraph  Name="Cross61" AutoHide="True" />
                                    </d3:ChartPlotter>
                                </Border>
                                <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="3" VerticalAlignment="Center" HorizontalAlignment="stretch"/>
                                <Border Grid.Row="2" Grid.Column="0" Margin="5" BorderBrush="Black" BorderThickness="1" CornerRadius="5" Visibility="{Binding ExpBRXDQ.UseAddT, Converter={StaticResource BVConverter}}">
                                    <d3:ChartPlotter x:Name="ChartPlotter62" >
                                        <d3:VerticalAxisTitle x:Name="AxisY_Default_Title62" Content="功率" />
                                        <d3:AxisGrid Visibility ="Visible "></d3:AxisGrid>
                                        <d3:LineGraph Name="Line63" StrokeThickness="0.6" DataSource="{Binding PlotLines[18].LineDataSource}" Stroke ="Red"></d3:LineGraph>
                                        <d3:CursorCoordinateGraph  Name="Cross62" AutoHide="True" />
                                    </d3:ChartPlotter>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                    <!--纵向分割线-->
                    <GridSplitter Grid.Row="1" Grid.Column="2" Grid.RowSpan="4" Width="3" VerticalAlignment="stretch" HorizontalAlignment="Stretch"/>

                    <!--右半屏，实验总体信息及操作-->
                    <Grid  Grid.Row="1" Grid.RowSpan="4" Grid.Column="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.1*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" BorderBrush="Black" BorderThickness="1" CornerRadius="5"  Margin="5" Padding="0" Background="DeepSkyBlue">
                            <Grid >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="60"/>
                                    <RowDefinition Height="55"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="60"/>
                                    <RowDefinition Height="60"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="当前试样：" Grid.Row="0" Grid.Column ="0" Style="{StaticResource TextBlock2}" Visibility="{Binding Dev.HideSY2345, Converter={StaticResource BVNotConverter}}"/>
                                <TextBox Text="{Binding ExpBRXDQ.SpNoDQ,Mode=OneWay}" Grid.Row="0" Grid.Column ="1" Style="{StaticResource TextBox4}" IsReadOnly="True" Visibility="{Binding Dev.HideSY2345, Converter={StaticResource BVNotConverter}}"/>
                                <TextBlock Text="/" Grid.Row="0" Grid.Column ="2" HorizontalAlignment="Center" Style="{StaticResource TextBlock2}" Visibility="{Binding Dev.HideSY2345, Converter={StaticResource BVNotConverter}}"/>
                                <TextBox Text="{Binding ExpBRXDQ.YPSL,Mode=OneWay}" Grid.Row="0" Grid.Column ="3" Style="{StaticResource TextBox4}" IsReadOnly="True" Visibility="{Binding Dev.HideSY2345, Converter={StaticResource BVNotConverter}}"/>

                                <TextBlock Text="试样切换：" Grid.Row="1" Grid.Column ="0" Style="{StaticResource TextBlock2}" Visibility="{Binding Dev.HideSY2345, Converter={StaticResource BVNotConverter}}"/>
                                <Button Command="{Binding MainWinCommand}" CommandParameter="1601" Grid.Row="1" Grid.Column ="1" Height="30" Width="30" Template="{StaticResource Button--}" 
                                        ToolTip="上一点" IsEnabled="{Binding Dev.IsNotBusy}" Visibility="{Binding Dev.HideSY2345, Converter={StaticResource BVNotConverter}}"/>
                                <TextBox Text="{Binding ExpBRXDQ.SpDQ.IsCompleted, Converter={StaticResource BTConverter},Mode=OneWay}" Grid.Row="1" Grid.Column ="2" Style="{StaticResource TextBox4}" FontWeight="Bold" FontSize="20" IsReadOnly="True" ToolTip="当前试样完成情况" />
                                <Button Command="{Binding MainWinCommand}" CommandParameter="1701" Grid.Row="1" Grid.Column ="3" Height="30" Width="30" Template="{StaticResource Button++}" 
                                        ToolTip="下一点" IsEnabled="{Binding Dev.IsNotBusy}" Visibility="{Binding Dev.HideSY2345, Converter={StaticResource BVNotConverter}}"/>

                                <Button Content="开始检测" Command="{Binding MainWinCommand}" CommandParameter="1101" Grid.Row="2" Grid.Column ="0" Width="90" Height="50" IsEnabled="{Binding Dev.IsNotBusy}"/>
                                <Button Content="停止检测" Command="{Binding MainWinCommand}" CommandParameter="1201" Grid.Row="2" Grid.Column ="1" Grid.ColumnSpan="3" Width="90" Height="50"  Foreground="Red" IsEnabled="{Binding Dev.IsBusy}"/>

                                <TextBlock Text="起始时间：" Grid.Row="3" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                                <TextBox Text="{Binding ExpBRXDQ.SpDQ.TimeSp.StartTime, StringFormat=yyyy-MM-dd HH:mm:ss,Mode=OneWay}" Grid.Row="3" Grid.Column ="1" Grid.ColumnSpan="3" Style="{StaticResource TextBox4}" IsReadOnly="True"/>

                                <TextBlock Text="运行时长：" Grid.Row="4" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                                <TextBox Text="{Binding ExpBRXDQ.SpDQ.TimeSp.TimeFromStart, Converter={StaticResource DoubleToMMSSConverter},Mode=OneWay}" Grid.Row="4" Grid.Column ="1" Grid.ColumnSpan="3" Style="{StaticResource TextBox4}" IsReadOnly="True" ToolTip="试样放入以后的时间"/>

                                <TextBlock Text="当前阶段：" Grid.Row="5" Grid.Column ="0" Style="{StaticResource TextBlock2}" FontWeight="Bold" Foreground="Red"/>
                                <TextBox Text="{Binding ExpBRXDQ.SpDQ.StageDQ, Converter={StaticResource TestStageConverter},Mode=OneWay}" Grid.Row="5" Grid.Column ="1" Grid.ColumnSpan="3" Style="{StaticResource TextBox4}" FontWeight="Bold" Foreground="Red" IsReadOnly="True"/>

                                <TextBlock Text="检测开始：" Grid.Row="6" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                                <TextBox Text="{Binding ExpBRXDQ.SpDQ.TimeTest30.StartTime, StringFormat=HH:mm:ss,Mode=OneWay}" Grid.Row="6" Grid.Column ="1" Grid.ColumnSpan="3" Style="{StaticResource TextBox4}" IsReadOnly="True"/>

                                <TextBlock Text="已测时长：" Grid.Row="7" Grid.Column ="0" Style="{StaticResource TextBlock2}" FontWeight="Bold" Foreground="Red" />
                                <TextBox Text="{Binding ExpBRXDQ.SpDQ.TimeTest30.TimeFromStart, Converter={StaticResource DoubleToMMSSConverter},Mode=OneWay}" Grid.Row="7" Grid.Column ="1" Grid.ColumnSpan="3" Style="{StaticResource TextBox4}" IsReadOnly="True" ToolTip="试验开始以后的时间" FontWeight="Bold" Foreground="OrangeRed"/>

                                <TextBlock Text="初始温度1：" Grid.Row="8" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                                <TextBlock Text="初始温度2：" Grid.Row="9" Grid.Column ="0" Style="{StaticResource TextBlock2}" Visibility="{Binding Dev.IsStd2023, Converter={StaticResource BVConverter}}"/>
                                <TextBox Text="{Binding ExpBRXDQ.SpDQ.TStart1,StringFormat=\{0:F2\} ℃, Mode=OneWay}" Grid.Row="8" Grid.Column ="1" Grid.ColumnSpan="3" Style="{StaticResource TextBox4}" IsReadOnly="True"/>
                                <TextBox Text="{Binding ExpBRXDQ.SpDQ.TStart2, StringFormat=\{0:F2\} ℃,Mode=OneWay}" Grid.Row="9" Grid.Column ="1" Grid.ColumnSpan="3" Style="{StaticResource TextBox4}" IsReadOnly="True" Visibility="{Binding Dev.IsStd2023, Converter={StaticResource BVConverter}}"/>

                                <Button Content="开始放入试样" Command="{Binding MainWinCommand}" CommandParameter="1301" Grid.Row="10" Grid.Column ="0" Grid.ColumnSpan="4" Width="200" Height="50" ToolTip="按下按钮后，开始正式测试。请在5秒内将试样放置到位" IsEnabled="{Binding Dev.T1StbBalanceEst.IsFitAll}"/>
                                <Button Content="火焰出现" Command="{Binding MainWinCommand}" CommandParameter="1401" Style="{StaticResource OrgButton}" Grid.Row="11" Grid.Column ="0" Width="90" Height="50" ToolTip="发现火焰后立即按下按钮，无需等待5s" IsEnabled="{Binding ExpBRXDQ.SpDQ.TimeTest30.IsStarted}"/>
                                <Button Content="火焰停止" Command="{Binding MainWinCommand}" CommandParameter="1501" Style="{StaticResource DgButton}" Grid.Row="11" Grid.Column ="2" Grid.ColumnSpan="2" Width="90" Height="50" IsEnabled="{Binding Dev.IsFired}"/>
                                <Ellipse Fill="{Binding Dev.IsFired, Converter={StaticResource BGConverter}}" Style="{StaticResource Ellipse1}" Grid.Row="11" Grid.Column ="1" ToolTip="燃烧状态指示"/>

                            </Grid>
                        </Border>

                        <GroupBox Header="T1平衡判定" Grid.Row="0"  Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5" BorderBrush="Black" FontSize="26" Background="LightBlue" mah:HeaderedControlHelper.HeaderFontSize="16">
                            <Grid >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="平衡时间(min)：" Grid.Row="0" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                                <TextBox Text="{Binding Dev.T1StbBalanceEst.TimeEqu, Converter={StaticResource IntToMMSSConverter},Mode=OneWay}" Grid.Row="0" Grid.Column ="1" Style="{StaticResource TextBox4}" IsReadOnly="True"/>
                                <TextBlock Text="T1温度漂移(℃)：" Grid.Row="1" Grid.Column ="0" Style="{StaticResource TextBlock2}" ToolTip="10min内温度漂移在2℃内"/>
                                <TextBlock Text="T1平均温度(℃)：" Grid.Row="2" Grid.Column ="0" Style="{StaticResource TextBlock2}" Visibility="{Binding ExpBRXDQ.SpDQ.TimeTest30.IsStarted, Converter={StaticResource BVNotConverter}}" ToolTip="10min内平均值在750±5℃内"/>
                                <TextBlock Text="T1最大偏差(℃)：" Grid.Row="3" Grid.Column ="0" Style="{StaticResource TextBlock2}" Visibility="{Binding ExpBRXDQ.SpDQ.TimeTest30.IsStarted, Converter={StaticResource BVNotConverter}}" ToolTip="10min内|T-Tavg|≤10℃"/>
                                <TextBox Text="{Binding Dev.T1StbBalanceEst.EDrift,StringFormat=\{0:F2\} ℃, Mode=OneWay}" Grid.Row="1" Grid.Column ="1" Style="{StaticResource TextBox4}" ToolTip="10min内温度漂移在2℃内"/>
                                <TextBox Text="{Binding Dev.T1StbBalanceEst.Y_Avg,StringFormat=\{0:F2\} ℃, Mode=OneWay}" Grid.Row="2" Grid.Column ="1" Style="{StaticResource TextBox4}" IsReadOnly="True" Visibility="{Binding ExpBRXDQ.SpDQ.TimeTest30.IsStarted, Converter={StaticResource BVNotConverter}}" ToolTip="10min内平均值在750±5℃内"/>
