                            <ComboBox ItemsSource="{Binding Dev.InfTypeList}" SelectedItem ="{Binding Dev .Mod_AO.Channels[1].InfType, Mode=TwoWay}" Grid.Row="2" Grid.Column ="1" IsEnabled ="False"/>
                            <ComboBox ItemsSource="{Binding Dev.InfTypeList}" SelectedItem ="{Binding Dev .Mod_AO.Channels[2].InfType, Mode=TwoWay}" Grid.Row="3" Grid.Column ="1" IsEnabled ="False"/>
                            <ComboBox ItemsSource="{Binding Dev.InfTypeList}" SelectedItem ="{Binding Dev .Mod_AO.Channels[3].InfType, Mode=TwoWay}" Grid.Row="4" Grid.Column ="1" IsEnabled ="False" />

                            <TextBlock Text="电信号单位" Grid.Row ="0" Grid.Column="2" Style="{StaticResource TextBlock1}"/>
                            <ComboBox ItemsSource="{Binding Dev.ElecSigUnitList}" SelectedItem ="{Binding Dev .Mod_AO.Channels[0].ElecSigUnit, Mode=TwoWay}" Grid.Row="1" Grid.Column ="2" IsEnabled ="False"/>
                            <ComboBox ItemsSource="{Binding Dev.ElecSigUnitList}" SelectedItem ="{Binding Dev .Mod_AO.Channels[1].ElecSigUnit, Mode=TwoWay}" Grid.Row="2" Grid.Column ="2" IsEnabled ="False"/>
                            <ComboBox ItemsSource="{Binding Dev.ElecSigUnitList}" SelectedItem ="{Binding Dev .Mod_AO.Channels[2].ElecSigUnit, Mode=TwoWay}" Grid.Row="3" Grid.Column ="2" IsEnabled ="False"/>
                            <ComboBox ItemsSource="{Binding Dev.ElecSigUnitList}" SelectedItem ="{Binding Dev .Mod_AO.Channels[3].ElecSigUnit, Mode=TwoWay}" Grid.Row="4" Grid.Column ="2" IsEnabled ="False"/>

                            <TextBlock Text="电信号下限" Grid.Row ="0" Grid.Column="3" Style="{StaticResource TextBlock1}"/>
                            <TextBox Text="{Binding Dev.Mod_AO.Channels[0].ElecSigLowerRange}" Grid.Row ="1" Grid.Column="3"/>
                            <TextBox Text="{Binding Dev.Mod_AO.Channels[1].ElecSigLowerRange}" Grid.Row ="2" Grid.Column="3"/>
                            <TextBox Text="{Binding Dev.Mod_AO.Channels[2].ElecSigLowerRange}" Grid.Row ="3" Grid.Column="3"/>
                            <TextBox Text="{Binding Dev.Mod_AO.Channels[3].ElecSigLowerRange}" Grid.Row ="4" Grid.Column="3"/>

                            <TextBlock Text="电信号上限" Grid.Row ="0" Grid.Column="4" Style="{StaticResource TextBlock1}"/>
                            <TextBox Text="{Binding Dev.Mod_AO.Channels[0].ElecSigUpperRange}" Grid.Row ="1" Grid.Column="4"/>
                            <TextBox Text="{Binding Dev.Mod_AO.Channels[1].ElecSigUpperRange}" Grid.Row ="2" Grid.Column="4"/>
                            <TextBox Text="{Binding Dev.Mod_AO.Channels[2].ElecSigUpperRange}" Grid.Row ="3" Grid.Column="4"/>
                            <TextBox Text="{Binding Dev.Mod_AO.Channels[3].ElecSigUpperRange}" Grid.Row ="4" Grid.Column="4"/>

                            <TextBlock Text="采集值下限" Grid.Row ="0" Grid.Column="5" Style="{StaticResource TextBlock1}"/>
                            <TextBox Text="{Binding Dev.Mod_AO.Channels[0].DataLowerRange}" Grid.Row ="1" Grid.Column="5"/>
                            <TextBox Text="{Binding Dev.Mod_AO.Channels[1].DataLowerRange}" Grid.Row ="2" Grid.Column="5"/>
                            <TextBox Text="{Binding Dev.Mod_AO.Channels[2].DataLowerRange}" Grid.Row ="3" Grid.Column="5"/>
                            <TextBox Text="{Binding Dev.Mod_AO.Channels[3].DataLowerRange}" Grid.Row ="4" Grid.Column="5"/>

                            <TextBlock Text="采集值上限" Grid.Row ="0" Grid.Column="6" Style="{StaticResource TextBlock1}"/>
                            <TextBox Text="{Binding Dev.Mod_AO.Channels[0].DataUpperRange}" Grid.Row ="1" Grid.Column="6"/>
                            <TextBox Text="{Binding Dev.Mod_AO.Channels[1].DataUpperRange}" Grid.Row ="2" Grid.Column="6"/>
                            <TextBox Text="{Binding Dev.Mod_AO.Channels[2].DataUpperRange}" Grid.Row ="3" Grid.Column="6"/>
                            <TextBox Text="{Binding Dev.Mod_AO.Channels[3].DataUpperRange}" Grid.Row ="4" Grid.Column="6"/>

                            <TextBlock Text="滤波系数" Grid.Row ="0" Grid.Column="7" Style="{StaticResource TextBlock1}"/>
                            <TextBox Text="{Binding Dev.Mod_AO.Channels[0].FitRatio}" Grid.Row ="1" Grid.Column="7" ToolTip ="滤波系数，1-50"/>
                            <TextBox Text="{Binding Dev.Mod_AO.Channels[1].FitRatio}" Grid.Row ="2" Grid.Column="7" ToolTip ="滤波系数，1-50"/>
                            <TextBox Text="{Binding Dev.Mod_AO.Channels[2].FitRatio}" Grid.Row ="3" Grid.Column="7" ToolTip ="滤波系数，1-50"/>
                            <TextBox Text="{Binding Dev.Mod_AO.Channels[3].FitRatio}" Grid.Row ="4" Grid.Column="7" ToolTip ="滤波系数，1-50"/>

                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

        </TabControl>
