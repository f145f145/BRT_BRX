<mah:MetroWindow  x:Class="BRX.View.CenterCalView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:local="clr-namespace:BRX.View"
                   xmlns:d3="http://research.microsoft.com/DynamicDataDisplay/1.0"
                  xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                  GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
                  xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
                  mc:Ignorable="d"
                  Title="不燃性测试仪—炉内校准"
                  Width="1366" Height="768"
                  WindowStartupLocation="CenterScreen" Background="White" ShowInTaskbar="True"
                  Closing="Window_Closing" WindowState="Normal " ResizeMode ="CanMinimize"
                  DataContext ="{Binding Source ={StaticResource Locator },Path =CalVM}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <!--=====主页面===================================================================================================-->
        <TabControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7" Margin="5">
            <!--===========炉内校准试验===========-->
            <TabItem Header="【炉内校准试验】" IsEnabled="True" mah:HeaderedControlHelper.HeaderFontSize="16" >
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="150" MinHeight="60" MaxHeight="500"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth ="300" MaxWidth="1200"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="600"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="炉内温度校准" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource TextBlock1}" FontSize="24" FontWeight="Bold"/>
                    <Button Content="关闭炉内校准" Command="{Binding CalWinCommand}" CommandParameter="5212" Grid.Row="0" Grid.Column ="2" Width="150" Height="40" HorizontalAlignment="Right" Margin="0,0,10,0"/>

                    <!--左上半屏，参数、状态-->
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="Black" BorderThickness="1" CornerRadius="5" Margin="5" Padding="5"  Background="DarkKhaki">
                        <Grid >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="炉内温度1：" Grid.Row="0" Grid.Column ="0" Style="{StaticResource TextBlock2}" Margin="0"/>
                            <TextBlock Text="炉内温度2：" Grid.Row="0" Grid.Column ="2" Style="{StaticResource TextBlock2}" Margin="0" Visibility="{Binding Dev.IsStd2023, Converter={StaticResource BVConverter}}"/>
                            <TextBlock Text="输出电压：" Grid.Row="0" Grid.Column ="4" Style="{StaticResource TextBlock2}" Margin="0"/>
                            <TextBox Text="{Binding Dev.AIList[0].ValueFinal, StringFormat={}{0:0.00} ℃}" Grid.Row="0" Grid.Column="1" Style="{StaticResource TextBox2}" IsReadOnly="True"/>
                            <TextBox Text="{Binding Dev.AIList[1].ValueFinal, StringFormat={}{0:0.00} ℃}" Grid.Row="0" Grid.Column="3" Style="{StaticResource TextBox2}" IsReadOnly="True" Visibility="{Binding Dev.IsStd2023, Converter={StaticResource BVConverter}}"/>
                            <TextBox Text="{Binding Dev.AOList[0].ValueFinal, StringFormat={}{0:0.00} %}" Grid.Row="0" Grid.Column="5" Style="{StaticResource TextBox2}" IsReadOnly="True" Visibility="{Binding Dev.IsStd2023, Converter={StaticResource BVConverter}}"/>

                            <TextBlock Text="校准点温度：" Grid.Row="1" Grid.Column ="0" Style="{StaticResource TextBlock2}" Margin="0"/>
                            <TextBox Text="{Binding Dev.AIList[7].ValueFinal, StringFormat={}{0:0.00} ℃}" Grid.Row="1" Grid.Column="1" Style="{StaticResource TextBox2}"  IsReadOnly="True"/>
                        </Grid>
                    </Border>

                    <!--横向分割线-->
                    <GridSplitter Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Height="3" VerticalAlignment="Center" HorizontalAlignment="stretch"/>
                    <!--左下屏-->
                    <Grid Grid.Row="3" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Margin="5" BorderBrush="Black" BorderThickness="1" CornerRadius="5">
                            <d3:ChartPlotter x:Name="ChartPlotterCenter1"  LegendVisible="False">
                                <d3:VerticalAxisTitle x:Name="AxisY_Default_TitleCenter1" Content="温度" />
                                <d3:AxisGrid Visibility ="Visible "></d3:AxisGrid>
                                <d3:LineGraph Name="LineCenter1" StrokeThickness="0.6" DataSource="{Binding PlotLines[0].LineDataSource}" Stroke ="Red"></d3:LineGraph>
                                <d3:LineGraph Name="LineCenter2" StrokeThickness="0.6" DataSource="{Binding PlotLines[1].LineDataSource}" Stroke ="Blue"></d3:LineGraph>
                                <d3:LineGraph Name="LineCenter3" StrokeThickness="0.6" DataSource="{Binding PlotLines[7].LineDataSource}" Stroke ="Green"></d3:LineGraph>
                                <d3:Legend Name="LegendLeft" HorizontalAlignment ="Left" />
                                <d3:CursorCoordinateGraph  Name="CrossCenter1" AutoHide="True" />
                            </d3:ChartPlotter>
                        </Border>
                       </Grid>
                    <!--纵向分割线-->
                    <GridSplitter Grid.Row="1" Grid.Column="2" Grid.RowSpan="4" Width="3" VerticalAlignment="stretch" HorizontalAlignment="Stretch"/>

                    <!--右半屏，实验总体信息及操作-->
                    <Grid  Grid.Row="1" Grid.RowSpan="4" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="150"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="260"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.75*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" BorderBrush="Black" BorderThickness="1" CornerRadius="5"  Margin="5" Padding="0" Background="DarkKhaki">
                            <Grid >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="当前校准：" Grid.Row="0" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                                <TextBox Text="{Binding CenterCalDQ.IsCompleted, Converter={StaticResource BTConverter},Mode=OneWay}" Grid.Row="0" Grid.Column ="1" ToolTip="当前试验完成情况" Style="{StaticResource TextBox4}" FontWeight="Bold" FontSize="20" IsReadOnly="True"/>
                                <TextBox Text="{Binding CenterCalDQ.ExpNO, Mode=OneWay}" Grid.Row="1" Grid.Column ="0" Grid.ColumnSpan="4"  Style="{StaticResource TextBox4}" IsReadOnly="True"/>
                                <TextBlock Text="完成数量：" Grid.Row="2" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                                <TextBox Text="{Binding CenterCalDQ.QtyComplete,Mode=OneWay}" Grid.Row="2" Grid.Column ="1" Style="{StaticResource TextBox4}" IsReadOnly="True"/>
                                <TextBlock Text="/" Grid.Row="2" Grid.Column ="2" HorizontalAlignment="Center" Style="{StaticResource TextBlock2}"/>
                                <TextBox Text="30" Grid.Row="2" Grid.Column ="3" Style="{StaticResource TextBox4}" IsReadOnly="True"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" BorderBrush="Black" BorderThickness="1" CornerRadius="5"  Margin="5" Padding="0" Background="Bisque">
                            <Grid >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="60"/>
                                    <RowDefinition Height="60"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="60"/>
                                    <RowDefinition Height="60"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="开始检测" Command="{Binding CalWinCommand}" CommandParameter="1103" Grid.Row="0" Grid.Column ="0" Width="90" Height="50" IsEnabled="{Binding Dev.IsNotBusy}"/>
                                <Button Content="停止检测" Command="{Binding CalWinCommand}" CommandParameter="1203" Grid.Row="0" Grid.Column ="1" Grid.ColumnSpan="3" Width="90" Height="50"  Foreground="Red" IsEnabled="{Binding Dev.IsBusy}"/>
                                <Button Content="当前点就绪" Command="{Binding CalWinCommand}" CommandParameter="1803" Grid.Row="1" Grid.Column ="0" Grid.ColumnSpan="1" Width="90" Height="50" ToolTip="将热电偶调整到位后再按下按钮" IsEnabled="{Binding Dev.IsBusy}"/>
                                <Button Content="当前点停止" Command="{Binding CalWinCommand}" CommandParameter="1813" Grid.Row="1" Grid.Column ="1" Grid.ColumnSpan="3" Width="90" Height="50" IsEnabled="{Binding CenterCalDQ.IsTesting}"/>

                                <TextBlock Text="当前高度：" Grid.Row="2" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                                <TextBox Text="{Binding CenterCalDQ.HeightPointDQ.PointH,StringFormat=\{0:F0\} mm,Mode=OneWay}" Grid.Row="2" Grid.Column ="1" Grid.ColumnSpan="2" Style="{StaticResource TextBox4}" IsReadOnly="True" ToolTip="测点高度"/>
                                <TextBox Text="{Binding CenterCalDQ.HeightPointDQ.Dir, Converter={StaticResource BDConverter}}" Grid.Row="2" Grid.Column ="3" Grid.ColumnSpan="1" Style="{StaticResource TextBox4}" IsReadOnly="True" ToolTip="校准测试行进方向"/>

                                <TextBlock Text="高度切换：" Grid.Row="3" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                                <Button Command="{Binding CalWinCommand}" CommandParameter="1603" Grid.Row="3" Grid.Column ="1" Height="30" Width="30" Template="{StaticResource Button--}" ToolTip="前一高度" IsEnabled="{Binding CenterCalDQ.IsNotTesting}" />
                                <TextBox Text="{Binding CenterCalDQ.HeightPointDQ.IsReced, Converter={StaticResource BTConverter},Mode=OneWay}" Grid.Row="3" Grid.Column ="2" Style="{StaticResource TextBox4}" FontWeight="Bold" FontSize="20" IsReadOnly="True" ToolTip="当前点完成情况" />
                                <Button Command="{Binding CalWinCommand}" CommandParameter="1703" Grid.Row="3" Grid.Column ="3" Height="30" Width="30" Template="{StaticResource Button++}" ToolTip="后一高度" IsEnabled="{Binding CenterCalDQ.IsNotTesting}" />

                                <TextBlock Text="起始时间：" Grid.Row="4" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                                <TextBox Text="{Binding CenterCalDQ.HeightPointDQ.TimePoint.StartTime, StringFormat=yyyy-MM-dd HH:mm:ss,Mode=OneWay}" Grid.Row="4" Grid.Column ="1" Grid.ColumnSpan="3" Style="{StaticResource TextBox4}" IsReadOnly="True"/>
                                <TextBlock Text="运行时长：" Grid.Row="5" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                                <TextBox Text="{Binding CenterCalDQ.HeightPointDQ.TimePoint.TimeFromStart, Converter={StaticResource DoubleToMMSSConverter},Mode=OneWay}" Grid.Row="5" Grid.Column ="1" Grid.ColumnSpan="3" Style="{StaticResource TextBox4}" IsReadOnly="True" ToolTip="当前点就绪后的时间"/>

                                <Button Content="记录当前点温度" Command="{Binding CalWinCommand}" CommandParameter="1903" Grid.Row="6" Grid.Column ="0" Grid.ColumnSpan="4" Width="200" Height="50" IsEnabled="{Binding Dev.T1StbBalanceEst.IsFitAll}"/>
                            </Grid>
                        </Border>

                        <GroupBox Header="温度平衡参数" Grid.Row="0"  Grid.Column="1" Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5" BorderBrush="Black" FontSize="26" Background="BurlyWood"  mah:HeaderedControlHelper.HeaderFontSize="16">
                            <Grid >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="3*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="平衡时间(min)：" Grid.Row="0" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                                <TextBox Text="{Binding Dev.T1StbBalanceEst.TimeEqu, Converter={StaticResource IntToMMSSConverter},Mode=OneWay}" Grid.Row="0" Grid.Column ="1" Style="{StaticResource TextBox4}" IsReadOnly="True"/>

                                <TextBlock Text="T1温度漂移(℃)：" Grid.Row="1" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                                <TextBlock Text="T1平均温度(℃)：" Grid.Row="2" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                                <TextBlock Text="T1最大偏差(℃)：" Grid.Row="3" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                                <TextBox Text="{Binding Dev.T1StbBalanceEst.EDrift,StringFormat=\{0:F2\} ℃, Mode=OneWay}" Grid.Row="1" Grid.Column ="1" Style="{StaticResource TextBox4}" IsReadOnly="True"/>
                                <TextBox Text="{Binding Dev.T1StbBalanceEst.Y_Avg,StringFormat=\{0:F2\} ℃, Mode=OneWay}" Grid.Row="2" Grid.Column ="1" Style="{StaticResource TextBox4}" IsReadOnly="True"/>
                                <TextBox Text="{Binding Dev.T1StbBalanceEst.DeviationMax,StringFormat=\{0:F2\} ℃, Mode=OneWay}" Grid.Row="3" Grid.Column ="1" Style="{StaticResource TextBox4}" IsReadOnly="True"/>

                                <TextBlock Text="2" Grid.Row="1" Grid.Column ="2" Style="{StaticResource TextBlock1}" FontWeight="Bold"/>
                                <TextBlock Text="10" Grid.Row="3" Grid.Column ="2" Style="{StaticResource TextBlock1}" FontWeight="Bold"/>
                                <Ellipse Fill="{Binding Dev.T1StbBalanceEst.IsDriftMeetsReqs, Converter={StaticResource BGConverter}}" Style="{StaticResource Ellipse1}" Grid.Row="1" Grid.Column ="3"/>
                                <Ellipse Fill="{Binding Dev.T1StbBalanceEst.IsDeviationMeetsReqs, Converter={StaticResource BGConverter}}" Style="{StaticResource Ellipse1}" Grid.Row="3" Grid.Column ="3"/>

                                <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" BorderThickness="1" CornerRadius="0"  Margin="0" Padding="0" Background="BurlyWood"  Visibility="{Binding Dev.IsStd2023, Converter={StaticResource BVConverter}}">
                                    <Grid >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="T2温度漂移(℃)：" Grid.Row="0" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                                        <TextBlock Text="T2平均温度(℃)：" Grid.Row="1" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                                        <TextBlock Text="T2最大偏差(℃)：" Grid.Row="2" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                                        <TextBox Text="{Binding Dev.T2StbBalanceEst.EDrift,StringFormat=\{0:F2\} ℃, Mode=OneWay}" Grid.Row="0" Grid.Column ="1" Style="{StaticResource TextBox4}" IsReadOnly="True"/>
                                        <TextBox Text="{Binding Dev.T2StbBalanceEst.Y_Avg,StringFormat=\{0:F2\} ℃, Mode=OneWay}" Grid.Row="1" Grid.Column ="1" Style="{StaticResource TextBox4}" IsReadOnly="True"/>
                                        <TextBox Text="{Binding Dev.T2StbBalanceEst.DeviationMax,StringFormat=\{0:F2\} ℃, Mode=OneWay}" Grid.Row="2" Grid.Column ="1" Style="{StaticResource TextBox4}" IsReadOnly="True"/>

                                        <TextBlock Text="2" Grid.Row="0" Grid.Column ="2" Style="{StaticResource TextBlock1}" FontWeight="Bold"/>
                                        <TextBlock Text="10" Grid.Row="2" Grid.Column ="2" Style="{StaticResource TextBlock1}" FontWeight="Bold"/>
                                        <Ellipse Fill="{Binding Dev.T2StbBalanceEst.IsDriftMeetsReqs, Converter={StaticResource BGConverter}}" Style="{StaticResource Ellipse1}" Grid.Row="0" Grid.Column ="3"/>
                                        <Ellipse Fill="{Binding Dev.T2StbBalanceEst.IsDeviationMeetsReqs, Converter={StaticResource BGConverter}}" Style="{StaticResource Ellipse1}" Grid.Row="2" Grid.Column ="3"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="温度控制参数" Grid.Row="2"  Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5" 
                                  BorderBrush="Black" FontSize="26" Background="BurlyWood" mah:HeaderedControlHelper.HeaderFontSize="16">
                            <Grid >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="稳定时间(min)" Grid.Row="0" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                                <TextBlock Text="控温目标(℃)：" Grid.Row="1" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                                <TextBlock Text="偏差范围(℃)：" Grid.Row="2" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                                <TextBlock Text="当前温度1(℃)：" Grid.Row="3" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                                <TextBlock Text="当前温度2(℃)：" Grid.Row="4" Grid.Column ="0" Style="{StaticResource TextBlock2}" Visibility="{Binding Dev.IsStd2023, Converter={StaticResource BVConverter}}"/>
                                <TextBox Text="{Binding Dev.T1StbBalanceEst.TimeEqu, Converter={StaticResource IntToMMSSConverter},Mode=OneWay}" Grid.Row="0" Grid.Column ="1" Style="{StaticResource TextBox4}" IsReadOnly="True"/>
                                <TextBox Text="{Binding Dev.T1StbBalanceEst.ValueAim,StringFormat=\{0:F2\} ℃, Mode=OneWay}" Grid.Row="1" Grid.Column ="1" Style="{StaticResource TextBox4}" IsReadOnly="True"/>
                                <TextBox Text="{Binding Dev.T1StbBalanceEst.EPermit,StringFormat=\{0:F2\} ℃, Mode=OneWay}" Grid.Row="2" Grid.Column ="1" Style="{StaticResource TextBox4}" IsReadOnly="True"/>
                                <TextBox Text="{Binding Dev.AIList[0].ValueFinal, StringFormat={}{0:0.00} ℃}" Grid.Row="3" Grid.Column ="1" Style="{StaticResource TextBox4}" IsReadOnly="True"/>
                                <TextBox Text="{Binding Dev.AIList[1].ValueFinal, StringFormat={}{0:0.00} ℃}" Grid.Row="4" Grid.Column ="1" Style="{StaticResource TextBox4}" IsReadOnly="True" Visibility="{Binding Dev.IsStd2023, Converter={StaticResource BVConverter}}"/>

                                <Ellipse Fill="{Binding Dev.T1StbBalanceEst.IsStabilized, Converter={StaticResource BGConverter}}" Style="{StaticResource Ellipse1}" Grid.Row="3" Grid.Column ="3"/>
                                <Ellipse Fill="{Binding Dev.T2StbBalanceEst.IsStabilized, Converter={StaticResource BGConverter}}" Style="{StaticResource Ellipse1}" Grid.Row="4" Grid.Column ="3" Visibility="{Binding Dev.IsStd2023, Converter={StaticResource BVConverter}}"/>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>


            <!--===========炉内校准管理===========-->
            <TabItem Header="【炉内校准管理】" IsEnabled="True" mah:HeaderedControlHelper.HeaderFontSize="16" mah:HeaderedControlHelper.HeaderForeground="{x:Null}" mah:TabControlHelper.UnderlineBrush="Blue" mah:TabControlHelper.CloseButtonEnabled="True" mah:TabControlHelper.UnderlineSelectedBrush="#CCFFFF00">
                <Grid  Background ="DarkKhaki">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="1.2*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.8*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!--试验列表-->
                    <Border Grid.Row="0" Grid.Column ="0" Grid.RowSpan ="5" BorderBrush="Black" BorderThickness="1" CornerRadius="5"  Margin="5" Background="Bisque" >
                        <Grid >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="炉内校准试验清单" Grid.Row="0" Style="{StaticResource TextBlock1}" FontSize="20" FontWeight="Bold"/>
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <DataGrid HorizontalAlignment ="Stretch"  VerticalAlignment="Stretch" Margin="0" 
                                      IsReadOnly="False"
                                      AutoGenerateColumns="False" 
                                      CanUserSortColumns="True"
                                      CanUserResizeColumns="True " CanUserResizeRows="True"  SelectionMode="Single"
                                      CanUserReorderColumns="True" AlternationCount="2"  RowHeaderWidth="0" CanUserAddRows="False" 
                                      ItemsSource="{Binding CenterCalTable}"
                                      SelectedValuePath="试验编号"
                                      SelectedValue="{Binding SelectedNOStr_CenterCal}"
                                      Background="BurlyWood" Width="1700">
                                    <DataGrid.Resources>
                                        <Style TargetType="ScrollBar">
                                            <Style.Triggers>
                                                <Trigger Property="Orientation" Value="Vertical">
                                                    <Setter Property="Width" Value="30"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="试验编号" Width="Auto" MinWidth="200" Binding="{Binding 试验编号,Mode=OneWay}"/>
                                        <DataGridTextColumn Header="5上" Width="*" Binding="{Binding 完成标志5U,Converter={StaticResource BTConverter},Mode=OneWay}"/>
                                        <DataGridTextColumn Header="5下" Width="*" Binding="{Binding 完成标志5D,Converter={StaticResource BTConverter},Mode=OneWay}"/>
                                        <DataGridTextColumn Header="15上" Width="*" Binding="{Binding 完成标志15U,Converter={StaticResource BTConverter},Mode=OneWay}"/>
                                        <DataGridTextColumn Header="15下" Width="*" Binding="{Binding 完成标志15D,Converter={StaticResource BTConverter},Mode=OneWay}"/>
                                        <DataGridTextColumn Header="25上" Width="*" Binding="{Binding 完成标志25U,Converter={StaticResource BTConverter},Mode=OneWay}"/>
                                        <DataGridTextColumn Header="25下" Width="*" Binding="{Binding 完成标志25D,Converter={StaticResource BTConverter},Mode=OneWay}"/>
                                        <DataGridTextColumn Header="35上" Width="*" Binding="{Binding 完成标志35U,Converter={StaticResource BTConverter},Mode=OneWay}"/>
                                        <DataGridTextColumn Header="35下" Width="*" Binding="{Binding 完成标志35D,Converter={StaticResource BTConverter},Mode=OneWay}"/>
                                        <DataGridTextColumn Header="45上" Width="*" Binding="{Binding 完成标志45U,Converter={StaticResource BTConverter},Mode=OneWay}"/>
                                        <DataGridTextColumn Header="45下" Width="*" Binding="{Binding 完成标志45D,Converter={StaticResource BTConverter},Mode=OneWay}"/>
                                        <DataGridTextColumn Header="55上" Width="*" Binding="{Binding 完成标志55U,Converter={StaticResource BTConverter},Mode=OneWay}"/>
                                        <DataGridTextColumn Header="55下" Width="*" Binding="{Binding 完成标志55D,Converter={StaticResource BTConverter},Mode=OneWay}"/>
                                        <DataGridTextColumn Header="65上" Width="*" Binding="{Binding 完成标志65U,Converter={StaticResource BTConverter},Mode=OneWay}"/>
                                        <DataGridTextColumn Header="65下" Width="*" Binding="{Binding 完成标志65D,Converter={StaticResource BTConverter},Mode=OneWay}"/>
                                        <DataGridTextColumn Header="75上" Width="*" Binding="{Binding 完成标志75U,Converter={StaticResource BTConverter},Mode=OneWay}"/>
                                        <DataGridTextColumn Header="75下" Width="*" Binding="{Binding 完成标志75D,Converter={StaticResource BTConverter},Mode=OneWay}"/>
                                        <DataGridTextColumn Header="85上" Width="*" Binding="{Binding 完成标志85U,Converter={StaticResource BTConverter},Mode=OneWay}"/>
