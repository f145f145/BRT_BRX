        <TextBlock Text="控温通讯：" Grid.Row="1" Grid.Column ="4" Style="{StaticResource TextBlock2}" Margin="0"/>
        <Ellipse Fill="{Binding Dev.AOComStatus.StatusCollor, Converter={StaticResource ComCollorConverter}}" Style="{StaticResource Ellipse1}" Grid.Row="1" Grid.Column ="5"/>
