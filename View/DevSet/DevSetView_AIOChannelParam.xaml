                </Grid>
            </TabItem>

            <TabItem Header="【AO输出】" mah:HeaderedControlHelper.HeaderFontSize="18" FontSize="16" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height=" *"/>
                        <RowDefinition Height=" *"/>
                    </Grid.RowDefinitions>
                    <GroupBox Header="AO输出" Grid.Row ="0" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderBrush="Black" Background="YellowGreen">
                        <Grid >
                            <Grid.RowDefinitions>
                                <RowDefinition Height=" Auto"/>
                                <RowDefinition Height=" *"/>
                                <RowDefinition Height=" *"/>
                                <RowDefinition Height=" *"/>
                                <RowDefinition Height=" *"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="通道编号" Grid.Row ="0" Grid.Column="0" Style="{StaticResource TextBlock1}"/>
                            <TextBox Text="{Binding Dev.Mod_AO.Channels[0].ChannelNO}" Grid.Row ="1" Grid.Column="0" IsEnabled ="False"/>
                            <TextBox Text="{Binding Dev.Mod_AO.Channels[1].ChannelNO}" Grid.Row ="2" Grid.Column="0" IsEnabled ="False"/>
                            <TextBox Text="{Binding Dev.Mod_AO.Channels[2].ChannelNO}" Grid.Row ="3" Grid.Column="0" IsEnabled ="False"/>
