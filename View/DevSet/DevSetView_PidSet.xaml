<mah:MetroWindow x:Class="BRX.View.DevSet.DevSetView_PidSet"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:BRX.View.DevSet"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
                 mc:Ignorable="d"
                 Title="PID控制参数设定" Height="600" Width="700"
                 WindowStartupLocation="CenterScreen" Background="White" ShowInTaskbar="True"
                 Closing="Window_Closing" WindowState="Normal " ResizeMode ="CanMinimize"
                 DataContext ="{Binding Source ={StaticResource Locator },Path =MainVM}">

    <Grid Background ="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TabControl Grid.Row ="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="stretch" VerticalAlignment="stretch" Margin="5" mah:TabControlHelper.UnderlineBrush="Red" >
            <TabItem Header="【误差≥50℃】" Padding="5" mah:HeaderedControlHelper.HeaderFontSize="18" Background="LightSkyBlue">
                <Grid  Background="LightSkyBlue">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="比例系数kp：" Grid.Row="0" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="积分系数ki："  Grid.Row="1" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="微分系数kd："  Grid.Row="2" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBox Text="{Binding Dev.PID_T_Err50Up.PID_Param .Kp, Mode=TwoWay}" Grid.Row="0" Grid.Column ="1"/>
                    <TextBox Text="{Binding Dev.PID_T_Err50Up.PID_Param .Ki, Mode=TwoWay}"  Grid.Row="1" Grid.Column ="1"/>
                    <TextBox Text="{Binding Dev.PID_T_Err50Up.PID_Param .Kd, Mode=TwoWay}"  Grid.Row="2" Grid.Column ="1"/>

                    <TextBlock Text="计算周期T："  Grid.Row="0" Grid.Column ="2" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="积分周期Ti："  Grid.Row="1" Grid.Column ="2" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="微分周期Td："  Grid.Row="2" Grid.Column ="2" Style="{StaticResource TextBlock2}"/>
                    <TextBox Text="{Binding Dev.PID_T_Err50Up.PID_Param .T}"  Grid.Row="0" Grid.Column ="3" IsEnabled ="False "/>
                    <TextBox Text="{Binding Dev.PID_T_Err50Up.PID_Param .Ti,Mode=OneWay }"  Grid.Row="1" Grid.Column ="3" IsEnabled ="False "/>
                    <TextBox Text="{Binding Dev.PID_T_Err50Up.PID_Param .Td,Mode=OneWay }"  Grid.Row="2" Grid.Column ="3" IsEnabled ="False "/>

                    <TextBlock Text="输出上限：" Grid.Row="3" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="输出下限：" Grid.Row="3" Grid.Column ="2" Style="{StaticResource TextBlock2}"/>
                    <TextBox Text="{Binding Dev.PID_T_Err50Up.PID_Param .U_UpperBound , Mode=TwoWay}" Grid.Row="3" Grid.Column ="1"/>
                    <TextBox Text="{Binding Dev.PID_T_Err50Up.PID_Param .U_LowerBound  , Mode=TwoWay}" Grid.Row="3" Grid.Column ="3"/>

                    <TextBlock Text="积分限幅："  Grid.Row="4" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="积分限幅值："  Grid.Row="4" Grid.Column ="2" Style="{StaticResource TextBlock2}"/>
                    <CheckBox Content="启用积分限幅" IsChecked ="{Binding Dev.PID_T_Err50Up.PID_Param.Is_UILimit_Used,Mode =TwoWay}" Grid.Row="4" Grid.Column="1" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBox Text="{Binding Dev.PID_T_Err50Up.PID_Param.U_IMax_Limit , Mode=TwoWay}"  Grid.Row="4" Grid.Column ="3"/>

                    <TextBlock Text="积分分离："  Grid.Row="5" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="积分分离误差值："  Grid.Row="5" Grid.Column ="2" Style="{StaticResource TextBlock2}"/>
                    <CheckBox Content="启用积分分离" IsChecked ="{Binding Dev.PID_T_Err50Up.PID_Param.Is_ISeparate_Used,Mode =TwoWay}" Grid.Row="5" Grid.Column="1" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" ToolTip="误差小于设定误差时，禁用积分"/>
                    <TextBox Text="{Binding Dev.PID_T_Err50Up.PID_Param .ErrBound_IntegralSeparate , Mode=TwoWay}"  Grid.Row="5" Grid.Column ="3"/>

                    <TextBlock Text="控制器类型："  Grid.Row="6" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBox Text="{Binding Dev.PID_T_Err50Up.PID_Param .ControllerType , Mode=TwoWay}" IsEnabled="False" Grid.Row="6" Grid.Column ="1"/>
                </Grid>
            </TabItem>

            <TabItem Header="【15≤误差＜50℃】" Padding="5" mah:HeaderedControlHelper.HeaderFontSize="18" Background="LightGreen">
                <Grid  Background="LightGreen">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="比例系数kp：" Grid.Row="0" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="积分系数ki："  Grid.Row="1" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="微分系数kd："  Grid.Row="2" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBox Text="{Binding Dev.PID_T_Err15_50.PID_Param .Kp, Mode=TwoWay}" Grid.Row="0" Grid.Column ="1"/>
                    <TextBox Text="{Binding Dev.PID_T_Err15_50.PID_Param .Ki, Mode=TwoWay}"  Grid.Row="1" Grid.Column ="1"/>
                    <TextBox Text="{Binding Dev.PID_T_Err15_50.PID_Param .Kd, Mode=TwoWay}"  Grid.Row="2" Grid.Column ="1"/>

                    <TextBlock Text="计算周期T："  Grid.Row="0" Grid.Column ="2" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="积分周期Ti："  Grid.Row="1" Grid.Column ="2" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="微分周期Td："  Grid.Row="2" Grid.Column ="2" Style="{StaticResource TextBlock2}"/>
                    <TextBox Text="{Binding Dev.PID_T_Err15_50.PID_Param .T}"  Grid.Row="0" Grid.Column ="3" IsEnabled ="False "/>
                    <TextBox Text="{Binding Dev.PID_T_Err15_50.PID_Param .Ti,Mode=OneWay }"  Grid.Row="1" Grid.Column ="3" IsEnabled ="False "/>
                    <TextBox Text="{Binding Dev.PID_T_Err15_50.PID_Param .Td,Mode=OneWay }"  Grid.Row="2" Grid.Column ="3" IsEnabled ="False "/>

                    <TextBlock Text="输出上限：" Grid.Row="3" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="输出下限：" Grid.Row="3" Grid.Column ="2" Style="{StaticResource TextBlock2}"/>
                    <TextBox Text="{Binding Dev.PID_T_Err15_50.PID_Param .U_UpperBound , Mode=TwoWay}" Grid.Row="3" Grid.Column ="1"/>
                    <TextBox Text="{Binding Dev.PID_T_Err15_50.PID_Param .U_LowerBound  , Mode=TwoWay}" Grid.Row="3" Grid.Column ="3"/>

                    <TextBlock Text="积分限幅："  Grid.Row="4" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="积分限幅值："  Grid.Row="4" Grid.Column ="2" Style="{StaticResource TextBlock2}"/>
                    <CheckBox Content="启用积分限幅" IsChecked ="{Binding Dev.PID_T_Err15_50.PID_Param.Is_UILimit_Used,Mode =TwoWay}" Grid.Row="4" Grid.Column="1" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBox Text="{Binding Dev.PID_T_Err15_50.PID_Param .U_IMax_Limit , Mode=TwoWay}"  Grid.Row="4" Grid.Column ="3"/>

                    <TextBlock Text="积分分离："  Grid.Row="5" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="积分分离误差值："  Grid.Row="5" Grid.Column ="2" Style="{StaticResource TextBlock2}"/>
                    <CheckBox Content="启用积分分离" IsChecked ="{Binding Dev.PID_T_Err15_50.PID_Param.Is_ISeparate_Used,Mode =TwoWay}" Grid.Row="5" Grid.Column="1" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" ToolTip="误差小于设定误差时，禁用积分"/>
                    <TextBox Text="{Binding Dev.PID_T_Err15_50.PID_Param .ErrBound_IntegralSeparate , Mode=TwoWay}"  Grid.Row="5" Grid.Column ="3"/>

                    <TextBlock Text="控制器类型："  Grid.Row="6" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBox Text="{Binding Dev.PID_T_Err15_50.PID_Param .ControllerType , Mode=TwoWay}" IsEnabled="False" Grid.Row="6" Grid.Column ="1"/>
                </Grid>
            </TabItem>

            <TabItem Header="【0≤误差＜15℃】" Padding="5" mah:HeaderedControlHelper.HeaderFontSize="18" Background="Gold">
                <Grid  Background="Goldenrod">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="比例系数kp：" Grid.Row="0" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="积分系数ki："  Grid.Row="1" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="微分系数kd："  Grid.Row="2" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBox Text="{Binding Dev.PID_T_Err0_15.PID_Param .Kp, Mode=TwoWay}" Grid.Row="0" Grid.Column ="1"/>
                    <TextBox Text="{Binding Dev.PID_T_Err0_15.PID_Param .Ki, Mode=TwoWay}"  Grid.Row="1" Grid.Column ="1"/>
                    <TextBox Text="{Binding Dev.PID_T_Err0_15.PID_Param .Kd, Mode=TwoWay}"  Grid.Row="2" Grid.Column ="1"/>

                    <TextBlock Text="计算周期T："  Grid.Row="0" Grid.Column ="2" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="积分周期Ti："  Grid.Row="1" Grid.Column ="2" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="微分周期Td："  Grid.Row="2" Grid.Column ="2" Style="{StaticResource TextBlock2}"/>
                    <TextBox Text="{Binding Dev.PID_T_Err0_15.PID_Param .T}"  Grid.Row="0" Grid.Column ="3" IsEnabled ="False "/>
                    <TextBox Text="{Binding Dev.PID_T_Err0_15.PID_Param .Ti,Mode=OneWay }"  Grid.Row="1" Grid.Column ="3" IsEnabled ="False "/>
                    <TextBox Text="{Binding Dev.PID_T_Err0_15.PID_Param .Td,Mode=OneWay }"  Grid.Row="2" Grid.Column ="3" IsEnabled ="False "/>

                    <TextBlock Text="输出上限：" Grid.Row="3" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="输出下限：" Grid.Row="3" Grid.Column ="2" Style="{StaticResource TextBlock2}"/>
                    <TextBox Text="{Binding Dev.PID_T_Err0_15.PID_Param .U_UpperBound , Mode=TwoWay}" Grid.Row="3" Grid.Column ="1"/>
                    <TextBox Text="{Binding Dev.PID_T_Err0_15.PID_Param .U_LowerBound  , Mode=TwoWay}" Grid.Row="3" Grid.Column ="3"/>

                    <TextBlock Text="积分限幅："  Grid.Row="4" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="积分限幅值："  Grid.Row="4" Grid.Column ="2" Style="{StaticResource TextBlock2}"/>
                    <CheckBox Content="启用积分限幅" IsChecked ="{Binding Dev.PID_T_Err0_15.PID_Param.Is_UILimit_Used,Mode =TwoWay}" Grid.Row="4" Grid.Column="1" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBox Text="{Binding Dev.PID_T_Err0_15.PID_Param .U_IMax_Limit , Mode=TwoWay}"  Grid.Row="4" Grid.Column ="3"/>

                    <TextBlock Text="积分分离："  Grid.Row="5" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="积分分离误差值："  Grid.Row="5" Grid.Column ="2" Style="{StaticResource TextBlock2}"/>
                    <CheckBox Content="启用积分分离" IsChecked ="{Binding Dev.PID_T_Err0_15.PID_Param.Is_ISeparate_Used,Mode =TwoWay}" Grid.Row="5" Grid.Column="1" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" ToolTip="误差小于设定误差时，禁用积分"/>
                    <TextBox Text="{Binding Dev.PID_T_Err0_15.PID_Param .ErrBound_IntegralSeparate , Mode=TwoWay}"  Grid.Row="5" Grid.Column ="3"/>

                    <TextBlock Text="控制器类型："  Grid.Row="6" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBox Text="{Binding Dev.PID_T_Err0_15.PID_Param .ControllerType , Mode=TwoWay}" IsEnabled="False" Grid.Row="6" Grid.Column ="1"/>
                </Grid>
            </TabItem>

            <TabItem Header="【功率控制PID】" Padding="5" mah:HeaderedControlHelper.HeaderFontSize="18" Background="LightGray">
                <Grid  Background="LightGray">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="比例系数kp：" Grid.Row="0" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="积分系数ki："  Grid.Row="1" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="微分系数kd："  Grid.Row="2" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBox Text="{Binding Dev.PID_Power.PID_Param .Kp, Mode=TwoWay}" Grid.Row="0" Grid.Column ="1"/>
                    <TextBox Text="{Binding Dev.PID_Power.PID_Param .Ki, Mode=TwoWay}"  Grid.Row="1" Grid.Column ="1"/>
                    <TextBox Text="{Binding Dev.PID_Power.PID_Param .Kd, Mode=TwoWay}"  Grid.Row="2" Grid.Column ="1"/>

                    <TextBlock Text="计算周期T："  Grid.Row="0" Grid.Column ="2" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="积分周期Ti："  Grid.Row="1" Grid.Column ="2" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="微分周期Td："  Grid.Row="2" Grid.Column ="2" Style="{StaticResource TextBlock2}"/>
                    <TextBox Text="{Binding Dev.PID_Power.PID_Param .T}"  Grid.Row="0" Grid.Column ="3" IsEnabled ="False "/>
                    <TextBox Text="{Binding Dev.PID_Power.PID_Param .Ti,Mode=OneWay }"  Grid.Row="1" Grid.Column ="3" IsEnabled ="False "/>
                    <TextBox Text="{Binding Dev.PID_Power.PID_Param .Td,Mode=OneWay }"  Grid.Row="2" Grid.Column ="3" IsEnabled ="False "/>

                    <TextBlock Text="输出上限：" Grid.Row="3" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="输出下限：" Grid.Row="3" Grid.Column ="2" Style="{StaticResource TextBlock2}"/>
                    <TextBox Text="{Binding Dev.PID_Power.PID_Param .U_UpperBound , Mode=TwoWay}" Grid.Row="3" Grid.Column ="1"/>
                    <TextBox Text="{Binding Dev.PID_Power.PID_Param .U_LowerBound  , Mode=TwoWay}" Grid.Row="3" Grid.Column ="3"/>

                    <TextBlock Text="积分限幅："  Grid.Row="4" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="积分限幅值："  Grid.Row="4" Grid.Column ="2" Style="{StaticResource TextBlock2}"/>
                    <CheckBox Content="启用积分限幅" IsChecked ="{Binding Dev.PID_Power.PID_Param.Is_UILimit_Used,Mode =TwoWay}" Grid.Row="4" Grid.Column="1" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBox Text="{Binding Dev.PID_Power.PID_Param .U_IMax_Limit , Mode=TwoWay}"  Grid.Row="4" Grid.Column ="3"/>

                    <TextBlock Text="积分分离："  Grid.Row="5" Grid.Column ="0" Style="{StaticResource TextBlock2}"/>
                    <TextBlock Text="积分分离误差值："  Grid.Row="5" Grid.Column ="2" Style="{StaticResource TextBlock2}"/>
                    <CheckBox Content="启用积分分离" IsChecked ="{Binding Dev.PID_Power.PID_Param.Is_ISeparate_Used,Mode =TwoWay}" Grid.Row="5" Grid.Column="1" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" ToolTip="误差小于设定误差时，禁用积分"/>
                    <TextBox Text="{Binding Dev.PID_Power.PID_Param .ErrBound_IntegralSeparate , Mode=TwoWay}"  Grid.Row="5" Grid.Column ="3"/>

